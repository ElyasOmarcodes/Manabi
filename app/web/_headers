# Engine, fonts and images keep their names between builds only when they
# do not change, so they are kept a week; the app shell is always checked.
/canvaskit/*
  Cache-Control: public, max-age=604800
/assets/*
  Cache-Control: public, max-age=604800
/icons/*
  Cache-Control: public, max-age=604800
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/main.dart.js
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/flutter_service_worker.js
  Cache-Control: no-cache
